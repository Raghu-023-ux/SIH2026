# Production Backend API URL (FastAPI Endpoint)
# Local development: http://localhost:8000
# Production: https://api.yourdisasterdomain.gov.in (or container service URL)
NEXT_PUBLIC_API_URL=https://api.yourdisasterdomain.gov.in
