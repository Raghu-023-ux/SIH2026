# -------------------------------------------------------------
# SIH26001 - Disaster Intelligence Engine Environment Variables
# -------------------------------------------------------------

# Application
PROJECT_NAME="SIH26001 - Disaster Intelligence Engine (NER Landslide)"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Local SQLite default (uncomment for zero-config local runs):
DATABASE_URL=sqlite+aiosqlite:///./sih_disaster.db
# PostgreSQL (uncomment for docker / production deployment):
# DATABASE_URL=postgresql+asyncpg://sih_user:sih_password@localhost:5432/sih_disaster_db

# Redis Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Analytical Risk Weights (Prototype Landslide Model)
WEIGHT_RAINFALL_INTENSITY=0.20
WEIGHT_RAINFALL_ANOMALY=0.20
WEIGHT_RAINFALL_PERSISTENCE=0.15
WEIGHT_SOIL_MOISTURE=0.20
WEIGHT_SOIL_MOISTURE_TREND=0.10
WEIGHT_SLOPE_ELEVATION=0.10
WEIGHT_HISTORICAL_SUSCEPTIBILITY=0.05

# Risk Level Thresholds
THRESHOLD_MODERATE=25.0
THRESHOLD_HIGH=50.0
THRESHOLD_CRITICAL=75.0
