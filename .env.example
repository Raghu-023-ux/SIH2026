# ==============================================================================
# SIH26001 - Disaster Intelligence Engine & Command Center
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and configure with your service credentials.
# NEVER commit actual secrets or credentials to Git.
# ==============================================================================

# Application Environment & Engine Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_MODE=LIVE
ENGINE_VERSION=prototype-v0.3

# ==============================================================================
# 1. Supabase PostgreSQL Database Configuration
# ==============================================================================
# Async connection URL for application (asyncpg dialect)
# Local SQLite default: sqlite+aiosqlite:///./sih_disaster.db
# Supabase Pooler: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./sih_disaster.db

# Direct connection URL (used for migrations and DDL, port 5432)
# Supabase Direct: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=

# Connection Pool Settings (Optimized for serverless / Supabase Transaction Pooler)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_SSL_MODE=prefer

# ==============================================================================
# 2. Redis & Upstash Redis Cache Configuration
# ==============================================================================
# Upstash Redis REST API Configuration (Recommended for Serverless / Cloud)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Standard TCP Redis URL (Local development / Docker fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
REDIS_TIMEOUT_SECONDS=3.0

# Granular Caching TTLs (Seconds)
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_FORECAST_CACHE_TTL_SECONDS=900
BHOONIDHI_CACHE_TTL_SECONDS=1800
HISTORICAL_CACHE_TTL_SECONDS=43200
TERRAIN_CACHE_TTL_SECONDS=86400

# ==============================================================================
# 3. External Weather & Earth Observation Providers
# ==============================================================================
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=7.0
WEATHER_MAX_RETRIES=2

# ISRO / NRSC Bhoonidhi Open Data Integration
BHOONIDHI_API_URL=https://bhoonidhi.nrsc.gov.in/api
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_PROVIDER_MODE=MOCK
BHOONIDHI_CACHE_TTL_SECONDS=1800

# ==============================================================================
# 4. Agentic AI & Explanations (Google AI Studio / Gemini)
# ==============================================================================
GEMINI_API_KEY=your_google_ai_studio_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini
AI_MODE=LIVE
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=20.0
AI_EXPLANATION_CACHE_TTL_SECONDS=900

# ==============================================================================
# 5. Security & CORS
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
