# ==============================================================================
# SIH26001 - Disaster Intelligence Engine Backend Environment Template
# ==============================================================================
# Copy this file to .env or configure in your production container environment.
#
# --- MODES EXPLANATION ---
# DEVELOPMENT: DATA_MODE=LIVE, DATABASE_URL=sqlite, REDIS=in_memory or local
# SIMULATION/DEMO: DATA_MODE=SIMULATION (Deterministic physical scenarios)
# PRODUCTION/LIVE: DATA_MODE=LIVE (Open-Meteo live data, Supabase PostgreSQL, Upstash Redis)
# ==============================================================================

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
DATA_MODE=LIVE
ENGINE_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL (Production)
# ------------------------------------------------------------------------------
# Supabase Transaction Pooler URL (Port 6543, SSL Required)
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Direct URL for schema migrations (Port 5432)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Connection Pool Settings (Optimized for Transaction Pooler)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_SSL_MODE=require

# ------------------------------------------------------------------------------
# 2. Upstash Redis (Production Cache & Rate Limiter)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://[YOUR-UPSTASH-INSTANCE].upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
REDIS_URL=
REDIS_CACHE_ENABLED=true
REDIS_TIMEOUT_SECONDS=3.0

# Cache TTLs (Seconds)
WEATHER_CACHE_TTL_SECONDS=300
WEATHER_FORECAST_CACHE_TTL_SECONDS=900
BHOONIDHI_CACHE_TTL_SECONDS=1800
HISTORICAL_CACHE_TTL_SECONDS=43200
TERRAIN_CACHE_TTL_SECONDS=86400
AI_EXPLANATION_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 3. Live Environmental Providers (Open-Meteo)
# ------------------------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_REQUEST_TIMEOUT_SECONDS=7.0
WEATHER_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. Earth Observation (ISRO / NRSC Bhoonidhi Open Data Gateway)
# ------------------------------------------------------------------------------
BHOONIDHI_API_URL=https://bhoonidhi.nrsc.gov.in/api
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_PROVIDER_MODE=LIVE

# ------------------------------------------------------------------------------
# 5. Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=studio-4032992257-84f15
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROVIDER_MODE=LIVE
FIREBASE_APP_NAME=sih-landslide-fcm

# ------------------------------------------------------------------------------
# 6. Email Notifications (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=alerts@yourdisasteragency.gov.in
RESEND_PROVIDER_MODE=LIVE
APP_BASE_URL=https://your-disaster-app.vercel.app

# ------------------------------------------------------------------------------
# 7. Agentic AI & Downstream Explanations (Google AI Studio / Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER=gemini
AI_MODE=LIVE
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=20.0

# ------------------------------------------------------------------------------
# 8. Security & CORS Allowed Origins
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["https://your-disaster-app.vercel.app","http://localhost:3000"]
